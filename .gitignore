# External GPL reference sources — fetched, never committed (plan §9.3 provenance hygiene).
# Populated by tools/fetch_references.sh; treated as read-only references, not copied.
/references/*
!/references/.gitkeep
!/references/PROVENANCE.md

# Kernel out-of-tree build artifacts
*.o
*.ko
*.mod
*.mod.c
*.mod.o
*.cmd
*.symvers
*.order
.tmp_versions/
modules.builtin*
*.rmeta
*.rlib
.*.d

# Rust / editor tooling (rust-project.json is GENERATED, not a source of truth — plan §6.1)
rust-project.json
target/
*.rs.bk
.claude/

# Logs and captured serial output
*.log
/var-log-*

# Packet captures - bound them via tools/safe_capture.sh; never commit ad-hoc dumps.
# (gitignore does not untrack the one already-tracked baseline under docs/baseline/.)
*.pcap
*.pcap[0-9]*
*.pcapng

# OS / editor cruft
.DS_Store
*.swp
*~

# Orchestration run evidence (BUILD_TEST_ORCHESTRATION.md): raw N-repeat run
# dirs are not committed — only curated summaries are. See that doc's
# "Resolved Review Questions".
docs/perf/runs/
