# config/devices.env — single source of truth for build/test orchestration.
# See docs/BUILD_TEST_ORCHESTRATION.md. This file is *sourced by bash*, so it
# executes: keep it repo-owned, plain assignments only, no command substitution.
#
# Values marked "verified" were confirmed on hardware during the multi-queue debug session
# (2026-06-09). Values marked TODO must be confirmed by rt8125-status.sh before
# any target relies on them — a TODO target reports `unconfigured` and is
# skipped, never run with guessed values.

# -- Controller (local) --------------------------------------------------------
REPO_ROOT=/home/firestrand/Projects/Rt8125-driver/rtl8125-rs   # verified
EVIDENCE_ROOT=docs/perf

CONTROLLER_HOST=local
GATEWAY_HOST=gateway                 # verified — ~/.ssh/config alias (100.125.107.46)
KVM_HOST=rtl8125-guest               # verified — ~/.ssh/config alias (192.168.122.174)

# The controller is ALSO the KVM test peer (colocated): the guest's passthrough
# RTL8125 (enp5s0) is cabled to this host's enp4s0. So KVM runtime gates use a
# 2-node rig (controller=iperf server, guest=client) — NOT a gw_loopback netns.
CONTROLLER_PEER_IFACE=enp4s0         # verified — KVM peer port on this host
CONTROLLER_PEER_IP=10.0.0.1          # verified — iperf server addr for KVM tests

# -- Gateway (bare-metal validation) — verified this session -------------------
GATEWAY_REPO_ROOT=/home/firestrand/rtl8125-rs                 # verified
GATEWAY_KO=/home/firestrand/rtl8125-rs/src/r8125_rust.ko      # verified
GATEWAY_LOOPBACK=/home/firestrand/gw_loopback.sh             # verified
GATEWAY_IFACE=enp3s0                 # verified (DUT)
GATEWAY_BDF=0000:03:00.0             # verified
GATEWAY_PEER_IFACE=enp4s0            # verified
GATEWAY_DUT_NS=dut                   # verified
GATEWAY_PEER_NS=peer                 # verified
GATEWAY_PEER_IP=10.0.0.1             # verified
GATEWAY_LOCAL_IP=10.0.0.2            # verified
GATEWAY_KERNEL_FAMILY=7.0.0          # verified (built against 7.0.0-22-generic)
GATEWAY_RUSTC=rustc-1.93             # verified

# -- KVM guest — verified via rt8125-status.sh (libvirt VM `rtl8125-guest`) -----
# 2-node rig: guest enp5s0 (DUT, 10.0.0.2) <-> controller enp4s0 (peer, 10.0.0.1).
# Build + load happen IN-GUEST (no gw_loopback, no netns). Constraints (memory):
# UDP-TX is unusable on the VM clocksource (use TCP gates only here; UDP belongs
# on the gateway), and the VM auto-pauses if the libvirt host disk fills.
KVM_REPO_ROOT=/home/firestrand/rtl8125-rs   # verified (in-guest checkout)
KVM_KO=/home/firestrand/rtl8125-rs/src/r8125_rust.ko   # verified
KVM_IFACE=enp5s0                     # verified (DUT, passthrough RTL8125)
KVM_BDF=0000:05:00.0                 # verified
KVM_LOCAL_IP=10.0.0.2                # verified (guest test addr)
KVM_PEER_IP=10.0.0.1                 # verified (= CONTROLLER_PEER_IP)
KVM_KERNEL_FAMILY=7.0.0              # verified
KVM_RUSTC=/usr/lib/rust-1.93/bin/rustc   # verified (in-guest, on PATH for make)
# KVM gate groups — TCP only (UDP-TX is a VM clocksource artifact, not a driver
# signal; do UDP/latency/IRQ work on the gateway instead).
KVM_SMOKE_GATES="load_unload ping"
KVM_TCP_GATES="tx_counter_clean"

# -- Gate groups (folded in until large enough to split) -----------------------
STATIC_GATES="run_checks"                                          # host-only
GATEWAY_SMOKE_GATES="load_unload ping ethtool_snapshot"
GATEWAY_MQ_GATES="tx_counter_clean"                                # multi-queue blocker
GATEWAY_STRESS_GATES="active_soak"

# -- Measurement-contract defaults ---------------------------------------------
DEFAULT_REPEATS=3
DEFAULT_WARMUP=1
DEFAULT_IPERF_SECONDS=8
DEFAULT_TIMEOUT_SECONDS=15
DEFAULT_SOAK_HOURS=24
# Throughput sanity floor (Gbit/s): a counter-clean run with ~0 throughput means
# no traffic actually flowed (false pass). tx_counter_clean FAILS below this.
DEFAULT_MIN_TPUT_GBPS=1.0

# Realtek vendor:device the BDF must match (lockout / wrong-NIC guard).
PCI_ID_RTL8125=10ec:8125
