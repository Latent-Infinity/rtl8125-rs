+    unsafe extern "C" fn suspend_callback(dev: *mut bindings::device) -> c_int {
+        // SAFETY: the PM core passes the `struct device` embedded in a `pci_dev`
+        // that is bound to this driver; `container_of` recovers the `pci_dev`.
+        let pdev = unsafe {
+            &*container_of!(dev, bindings::pci_dev, dev).cast::<Device<device::CoreInternal>>()
+        };
+        // SAFETY: called between probe and remove, so drvdata holds a `T`.
+        let data = unsafe { pdev.as_ref().drvdata_borrow::<T>() };
+        from_result(|| {
+            T::suspend(pdev, data)?;
+            Ok(0)
+        })
+    }
+
+    unsafe extern "C" fn resume_callback(dev: *mut bindings::device) -> c_int {
+        // SAFETY: see `suspend_callback`.
+        let pdev = unsafe {
+            &*container_of!(dev, bindings::pci_dev, dev).cast::<Device<device::CoreInternal>>()
+        };
+        // SAFETY: see `suspend_callback`.
+        let data = unsafe { pdev.as_ref().drvdata_borrow::<T>() };
+        from_result(|| {
+            T::resume(pdev, data)?;
+            Ok(0)
+        })
+    }
+
+    const PM_OPS: bindings::dev_pm_ops = bindings::dev_pm_ops {
